# Configuración de la Raspberry Pi (P4-19, rúbrica 6.3). Plantilla SIN secretos.
# Copia a `app/edge/.env.pi` (ignorado por Git por el patrón `.env.*`) y ajusta.

# --- Identidad del dispositivo y modelo (contrato del evento v1) -----------------
DEVICE_ID=rpi-zero2w-01
MODEL_PATH=/home/pi/models/model_int8.onnx
MODEL_VERSION=resnet18-p3-v1.0.0-int8
# SHA-256 del .onnx cargado; debe coincidir con reports/p4/conversion_log.json (#5) y el publicado (#7).
MODEL_SHA256=58effa03a01cf847bb9a94a96c30247220b47bb394715949e404450ca4d9a1bb

# --- Captura ---------------------------------------------------------------------
CAMERA_INDEX=0
# Segundos entre capturas automáticas (0 = solo con botón/tecla).
CAPTURE_INTERVAL_S=0
# Recorte fijo en píxeles de la imagen original (vacío = sin recorte → crop: null).
CROP_X=
CROP_Y=
CROP_W=
CROP_H=
# Registro local antes de enviar (JPEG + log.jsonl con send_status).
CAPTURES_DIR=/home/pi/captures
TZ=America/Mexico_City

# --- Envío a AWS (#12) -----------------------------------------------------------
CAPTURES_API_URL=https://el1c2mr69k.execute-api.us-east-2.amazonaws.com
AWS_REGION=us-east-2
# Perfil en ~/.aws/credentials con la llave de mlops-p4-device-rpi-zero2w-01.
# La llave NUNCA va en este archivo ni en Git: se configura con
#   aws configure --profile mlops-p4-device
AWS_PROFILE=mlops-p4-device
SEND_TIMEOUT_S=15
