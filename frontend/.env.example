# URL base del backend.
#
# Déjalo vacío o con /api para usar el proxy de desarrollo definido en
# vite.config.ts, que reenvía a http://localhost:3000.
#
# En producción, apunta a la URL real del backend, por ejemplo:
#   VITE_API_BASE_URL=http://localhost:3100
VITE_API_BASE_URL=/api

# URL base de la API de lectura de capturas edge (#15). Si se omite o queda
# vacía, el portal usa el JSON de ejemplo (frontend/public/captures/sample.json).
#   VITE_CAPTURES_API_URL=https://xxxxxxxxxx.execute-api.us-east-2.amazonaws.com
VITE_CAPTURES_API_URL=
